  {
    "id": "fn_gen_vitals",
    "type": "function",
    "z": "tab_lab05",
    "name": "Generar Payload Biomédico",
    "func": "// Generar valores simulados aleatorios dentro de rango fisiológico\nlet bpm = Math.floor(Math.random() * (95 - 65 + 1)) + 65;\nlet spo2 = Math.floor(Math.random() * (100 - 95 + 1)) + 95;\nlet temp = Number((36.2 + Math.random() * 0.8).toFixed(1));\n\nmsg.payload = {\n    dispositivo: \"ESP32-ICU-UPCH\",\n    paciente_id: \"PAC-2026-01\",\n    bpm: bpm,\n    spo2: spo2,\n    temp_c: temp,\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 120,
    "wires": [
      [
        "mqtt_out_vitals"
      ]
    ]
  },
