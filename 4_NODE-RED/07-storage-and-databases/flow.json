    "payloadType": "json",
    "x": 190,
    "y": 120,
    "wires": [
      [
        "fn_format_csv_row"
      ]
    ]
  },
  {
    "id": "fn_format_csv_row",
    "type": "function",
    "z": "tab_lab07",
    "name": "Formatear Fila CSV",
    "func": "let d = msg.payload;\nlet now = new Date().toISOString();\nlet estado = (d.spo2 < 90 || d.bpm > 100) ? \"CRITICO\" : \"ESTABLE\";\n\n// Formato: ISO_Timestamp,PacienteID,BPM,SpO2,Temperatura,Estado\nmsg.payload = `${now},${d.paciente_id},${d.bpm},${d.spo2},${d.temp},${estado}`;\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 120,
    "wires": [
      [
        "file_append_log",
        "debug_log_saved"
      ]
    ]
  },
