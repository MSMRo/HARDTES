    "name": "Procesar y Confirmar",
    "func": "let d = msg.payload;\n\n// Registrar fecha de ingestión en el servidor\nd.recibido_en = new Date().toISOString();\n\n// Respuesta HTTP 201 Created para el ESP32\nmsg.statusCode = 201;\nmsg.payload = {\n    resultado: \"OK\",\n    nodo: d.nodo_id,\n    mensaje: \"Telemetría ingresada al sistema hospitalario con éxito\"\n};\n\nreturn msg;",
