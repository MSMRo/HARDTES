  {
    "id": "fn_check_emergency",
    "type": "function",
    "z": "tab_esp32_p08",
    "name": "Vigilancia de Alertas Clínicas",
    "func": "let d = msg.payload;\nlet alertaCritica = false;\nlet motivo = \"\";\n\nif (d.spo2 < 90) {\n    alertaCritica = true;\n    motivo = `Hipoxemia Severa (${d.spo2}%)`;\n} else if (d.bpm > 105) {\n    alertaCritica = true;\n    motivo = `Taquicardia Aguda (${d.bpm} lpm)`;\n}\n\n// Mensaje de telemetría procesado\nlet msgTelemetry = {\n    payload: {\n        paciente: d.paciente_id,\n        bpm: d.bpm,\n        spo2: d.spo2,\n        temp: d.temp_c,\n        alerta: alertaCritica ? motivo : \"NORMAL\",\n        uptime: d.uptime_s\n    }\n};\n\n// Si hay emergencia, disparar orden automática al ESP32 para activar alarma física\nlet msgComando = null;\nif (alertaCritica) {\n    msgComando = {\n        topic: \"upch/telesalud/paciente_01/comandos\",\n        payload: JSON.stringify({ accion: \"ACTIVAR_ALARMA\", motivo: motivo })\n    };\n}\n\nreturn [msgTelemetry, msgComando];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 510,
    "y": 140,
    "wires": [
      [
        "debug_vitals_monitored"
      ],
      [
        "mqtt_out_commands"
      ]
    ]
  },
